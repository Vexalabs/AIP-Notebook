# Kalshi Image Generation Service - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=PMP_Backend

# ============================================
# Google Cloud Platform Configuration
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=kalshi-vs-ai
GCP_REGION=us-central1

# Path to your GCP service account key JSON file
# This is required for authentication
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ============================================
# Optional Configuration
# ============================================
# Uncomment and set these if needed

# Maximum number of articles to process in one run
# MAX_ARTICLES=10

# Enable verbose logging (true/false)
# VERBOSE=false

# ============================================
# Notes
# ============================================
# 1. Never commit this file with real credentials to version control
# 2. Make sure .env is in your .gitignore file
# 3. The GCS bucket 'kalshi-vs-ai' should already exist
# 4. Your service account needs these permissions:
#    - roles/aiplatform.user (for Vertex AI)
#    - roles/storage.objectAdmin (for Cloud Storage)
